# -----------------------------------------------------------------------------
# Deployment images
# -----------------------------------------------------------------------------
SOVEREIGN_IMAGE=zerotier-sovereign:local

# -----------------------------------------------------------------------------
# PLANET / root server
# -----------------------------------------------------------------------------
# At least one public/reachable STATIC address is required.
PLANET_IP_ADDR4=
PLANET_IP_ADDR6=
PLANET_ZT_PORT=9994
PLANET_BIND_IP=0.0.0.0
PLANET_WORLD_TIMESTAMP=

# Authenticated PLANET download service. Loopback-only by default.
PLANET_FILE_BIND_IP=127.0.0.1
PLANET_FILE_PORT=3001
# Optional. Leave blank on the first boot to generate and persist a random key.
PLANET_FILE_KEY=

# -----------------------------------------------------------------------------
# Standalone Controller
# -----------------------------------------------------------------------------
CONTROLLER_ZT_PORT=9993
CONTROLLER_BIND_IP=0.0.0.0

# -----------------------------------------------------------------------------
# ztncui
# -----------------------------------------------------------------------------
ZTNCUI_BIND_IP=127.0.0.1
ZTNCUI_PORT=3000
# Optional. Leave blank to generate a one-time random admin password on first boot.
ZTNCUI_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Build pins (current validated baseline)
# One ZeroTier binary is built once and launched as two isolated processes.
# Normally maintained by GitHub Actions / versions.env.
# -----------------------------------------------------------------------------
SOVEREIGN_VERSION=0.6.0
ZEROTIER_VERSION=1.16.2
ZEROTIER_SOURCE_REF=fc5c3ec22090b5b2a0f274e863651fe9ca489bf4
# Build-time helper only: immutable ZTNet source commit containing ztmkworld.
MKWORLD_SOURCE_REF=3ba175a682d03edd72516d830667ee08fe3cf262
NODEJS_IMAGE=node:24-alpine3.24
