#!/usr/bin/env bash
set -Eeuo pipefail

PLANET_HOME=${PLANET_HOME:-/data/planet/one}
WORLD_DIR=${WORLD_DIR:-/data/planet/world}
DIST_DIR=${DIST_DIR:-/data/planet/dist}
CONFIG_DIR=${CONFIG_DIR:-/data/planet/config}
CONTROLLER_HOME=${CONTROLLER_HOME:-/data/controller/one}

mkdir -p "$PLANET_HOME" "$WORLD_DIR" "$DIST_DIR" "$CONFIG_DIR" "$CONTROLLER_HOME"
chmod 700 "$PLANET_HOME" "$WORLD_DIR" "$CONFIG_DIR" "$CONTROLLER_HOME" 2>/dev/null || true

# The controller uses the standard ZeroTier home symlink; PLANET state remains separate.
if [[ -e /var/lib/zerotier-one && ! -L /var/lib/zerotier-one ]]; then
  if [[ -n "$(find /var/lib/zerotier-one -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null)" ]]; then
    echo >&2 "FATAL: /var/lib/zerotier-one is a non-empty directory; refusing to replace it with Controller symlink."
    exit 20
  fi
  rmdir /var/lib/zerotier-one
fi
ln -sfn "$CONTROLLER_HOME" /var/lib/zerotier-one

# Generate or validate the sovereign root before either ZeroTier daemon starts.
planetctl ensure

if [[ ! -s "$DIST_DIR/planet" ]]; then
  echo >&2 "FATAL: custom PLANET was not generated."
  exit 21
fi
install -m 600 "$DIST_DIR/planet" "$CONTROLLER_HOME/planet"

# ztncui is in the same container, so keep Controller management loopback-only.
cat > "$CONTROLLER_HOME/local.conf" <<'JSON'
{
  "settings": {
    "allowManagementFrom": ["127.0.0.1/32", "::1/128"]
  }
}
JSON
chmod 600 "$CONTROLLER_HOME/local.conf"

exec /usr/local/bin/sovereign-supervise
