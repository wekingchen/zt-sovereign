#!/usr/bin/env bash
set -Eeuo pipefail

curl -fsS "http://127.0.0.1:${PLANET_FILE_SERVER_PORT:-3001}/healthz" >/dev/null
curl -fsS "http://127.0.0.1:${ZTNCUI_PORT:-3000}/" >/dev/null

home=${CONTROLLER_HOME:-/data/controller/one}
[[ -s "$home/authtoken.secret" ]]
token=$(<"$home/authtoken.secret")
curl -fsS -H "X-ZT1-Auth: $token" "http://127.0.0.1:${CONTROLLER_ZT_PORT:-9993}/status" >/dev/null

test -s "${DIST_DIR:-/data/planet/dist}/planet"
test -s "${WORLD_DIR:-/data/planet/world}/current.c25519"
test -s "${WORLD_DIR:-/data/planet/world}/previous.c25519"
