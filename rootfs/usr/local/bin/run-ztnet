#!/usr/bin/env bash
set -Eeuo pipefail

home=${CONTROLLER_HOME:-/data/controller/one}
port=${CONTROLLER_ZT_PORT:-9993}

for _ in $(seq 1 180); do
  if [[ -s "$home/authtoken.secret" ]]; then
    token=$(<"$home/authtoken.secret")
    if curl -fsS -H "X-ZT1-Auth: $token" "http://127.0.0.1:${port}/status" >/dev/null 2>&1; then
      export ZT_ADDR="http://127.0.0.1:${port}"
      export HOSTNAME=0.0.0.0
      cd /app
      exec /app/init-db.sh node server.js
    fi
  fi
  sleep 1
done

echo >&2 "FATAL: Controller API did not become ready in time."
exit 30
