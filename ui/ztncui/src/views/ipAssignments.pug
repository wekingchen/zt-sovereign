extends network_layout

block net_content
  if errors
    .alert.alert-warning
      strong 请检查下方错误

  form(method='POST' action='')
    .info-list
      .info-line
        strong 成员名称
        span= member.name
      .info-line
        strong ZeroTier 地址
        span.mono-text= member.id

    .section-heading
      div
        h3 IP 分配
        p.muted 管理此成员的受管 IP 地址

    .table-responsive
      table.table.table-striped.table-hover
        thead
          tr
            th
            th IP 地址
        tbody
          each ipAssignment, index in member.ipAssignments
            tr
              td
                a.btn.btn-link.btn-sm(role='button' href='/controller/network/' + network.nwid + '/member/' + member.id + '/ipAssignments/' + index + '/delete' title='删除 IP')
                  i.glyphicon.glyphicon-trash
              td.mono-text= ipAssignment
          tr
            td
              button.btn.btn-link.btn-sm(type='submit' title='添加 IP')
                i.glyphicon.glyphicon-plus
            td
              input#ipAddress.form-control(type='text' name='ipAddress' placeholder='输入 IP 地址' value=(undefined===ipAssignment? '' : ipAssignment.ipAddress))

    .section-heading
      div
        h3 受管路由
        p.muted 当前网络配置的可达网段
      a.btn.btn-default.btn-sm(href='/controller/network/' + network.nwid + '/routes') 管理路由

    .table-responsive
      table.table.table-striped.table-hover
        thead
          tr
            th
            th 目标网段
            th 网关
        tbody
          each route in network.routes
            tr
              td
                a.btn.btn-link.btn-sm(role='button' href='/controller/network/' + network.nwid + '/routes/' + route.target + '/delete' title='删除路由')
                  i.glyphicon.glyphicon-trash
              td.mono-text= route.target
              td.mono-text= route.via

  if errors
    .alert.alert-warning
      ul
        for err in errors
          li!= err.msg
