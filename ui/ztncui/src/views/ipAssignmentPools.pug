extends network_layout

block net_content
  .table-responsive
    table.table.table-striped.table-hover.mobile-stack
      thead
        tr
          th 起始 IP
          th 结束 IP
          th 操作
      tbody
        each ipAssignmentPool in network.ipAssignmentPools
          tr
            td.mono-text(data-label='起始 IP')= ipAssignmentPool.ipRangeStart
            td.mono-text(data-label='结束 IP')= ipAssignmentPool.ipRangeEnd
            td.mobile-actions(data-label='操作')
              a.btn.btn-link.btn-sm.btn-link-danger(href='/controller/network/' + network.nwid + '/ipAssignmentPools/' + ipAssignmentPool.ipRangeStart + '/' + ipAssignmentPool.ipRangeEnd + '/delete')
                span.glyphicon.glyphicon-trash.nav-icon
                | 删除

  .section-heading
    div
      h3 添加 IP 分配池
      p.muted 为成员自动分配地址范围

  form(method='POST' action='/controller/network/' + network.nwid + '/ipAssignmentPools')
    .form-group
      label(for='ipRangeStart') 起始 IP
      input#ipRangeStart.form-control(type='text' name='ipRangeStart' placeholder='起始 IP' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeStart))

    .form-group
      label(for='ipRangeEnd') 结束 IP
      input#ipRangeEnd.form-control(type='text' name='ipRangeEnd' placeholder='结束 IP' value=(undefined===ipAssignmentPool? '' : ipAssignmentPool.ipRangeEnd))

    .action-bar
      button.btn.btn-primary(type='submit') 保存
      a.btn.btn-default(href='/controller/network/' + network.nwid name='cancel' role='button') 取消

  if errors
    .alert.alert-warning
      ul
        for err in errors
          li!= err.msg
