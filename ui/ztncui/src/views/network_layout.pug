extends controller_layout

block content
  if error
    .alert.alert-danger
      strong #{error}
  else
    .context-header
      .context-heading
        block network_title
          .network-heading
            h2
              | 网络 
              a(href='/controller/network/' + network.nwid) #{network.name}
            span.network-id #{network.nwid}
        block title
          if title
            h3= title
      a.btn.btn-default.context-back(href=navigate.whence role='button')
        span.glyphicon.glyphicon-chevron-left.nav-icon
        | 返回
    block net_content
