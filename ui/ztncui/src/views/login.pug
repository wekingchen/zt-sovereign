extends login_layout

block login_content
  if error
    .alert.alert-danger
      strong #{error}
  else
    .auth-brand
      span.brand-mark
        i.glyphicon.glyphicon-random
      div
        h1 登录控制台
        p.auth-intro 使用管理员账号进入 ZeroTier Sovereign

    if message
      .alert.alert-info
        strong= message

    form(method='POST' action='')
      .form-group
        label.control-label(for='username') 用户名
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-user
          input#username.form-control(type='text' name='username' placeholder='请输入用户名' autocomplete='username' autofocus=true)

      .form-group
        label.control-label(for='password') 密码
        .input-group
          span.input-group-addon
            i.glyphicon.glyphicon-lock
          input#password.form-control(type='password' name='password' placeholder='请输入密码' autocomplete='current-password')

      .auth-actions
        button.btn.btn-primary.btn-block(type='submit') 登录
