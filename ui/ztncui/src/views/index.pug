extends controller_layout

block content
  if error
    .alert.alert-danger
      strong #{error}
  else
    .hero-panel
      .hero-copy
        .eyebrow ZERO TIER SOVEREIGN
        h1 网络控制台
        p.muted 自主管理 PLANET、Controller 与虚拟网络成员。
      .hero-badge
        span.glyphicon.glyphicon-ok-circle
        | Controller 在线

    .metric-grid
      .metric-card
        .metric-icon
          span.glyphicon.glyphicon-qrcode
        .metric-content
          span.metric-label Controller 地址
          strong.mono-text #{zt_status.address}
      .metric-card
        .metric-icon
          span.glyphicon.glyphicon-cog
        .metric-content
          span.metric-label ZeroTier 版本
          strong #{zt_status.version}
      .metric-card.metric-card-action
        .metric-icon
          span.glyphicon.glyphicon-globe
        .metric-content
          span.metric-label 网络管理
          a(href='/controller/networks') 查看全部网络
