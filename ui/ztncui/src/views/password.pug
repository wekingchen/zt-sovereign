extends users_layout

block users_heading_meta
  if readonly
    p.muted 修改现有管理员的登录密码
  else
    p.muted 创建新的控制台管理员账号

block users_content
  if message
    .alert.alert-info
      strong= message

  form.form-narrow(method='POST' action='')
    .form-group
      label(for='username') 用户名
      .input-group
        span.input-group-addon
          i.glyphicon.glyphicon-user
        input#username.form-control(type='text' name='username' placeholder='请输入用户名' value=user.name readonly=readonly)

    .form-group
      label(for='password1') 新密码
      .input-group
        span.input-group-addon
          i.glyphicon.glyphicon-lock
        input#password1.form-control(type='password' name='password1' placeholder='请输入新密码' value=(undefined===user.password1? '' : user.password1) autocomplete='new-password')

    .form-group
      label(for='password2') 确认新密码
      .input-group
        span.input-group-addon
          i.glyphicon.glyphicon-lock
        input#password2.form-control(type='password' name='password2' placeholder='请再次输入密码' value=(undefined===user.password2? '' : user.password2) autocomplete='new-password')

    .setting-row
      .setting-copy
        h4 下次登录时要求修改密码
        p.muted 启用后，用户下次登录必须先更新密码。
      .setting-control
        input#pass_set(type='checkbox' name='pass_set' value='check')

    .action-bar(style='margin-top: 22px;')
      button.btn.btn-primary(type='submit')
        span.glyphicon.glyphicon-ok.nav-icon
        if readonly
          | 保存密码
        else
          | 创建管理员
      a.btn.btn-default(href='/users' name='cancel' role='button') 取消

  if errors
    .alert.alert-warning
      ul
        for err in errors
          li!= err.msg
