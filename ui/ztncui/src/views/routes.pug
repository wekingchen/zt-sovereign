extends network_layout

block net_content
  .table-responsive
    table.table.table-striped.table-hover.mobile-stack
      thead
        tr
          th 目标网段
          th 网关
          th 操作
      tbody
        each route in network.routes
          tr
            td.mono-text(data-label='目标网段')= route.target
            td.mono-text(data-label='网关')= route.via
            td.mobile-actions(data-label='操作')
              a.btn.btn-link.btn-sm.btn-link-danger(href='/controller/network/' + network.nwid + '/routes/' + route.target + '/delete')
                span.glyphicon.glyphicon-trash.nav-icon
                | 删除

  .section-heading
    div
      h3 添加路由
      p.muted 配置通过此 ZeroTier 网络可达的目标网段

  form(method='POST' action='/controller/network/' + network.nwid + '/routes')
    .form-group
      label(for='target') 目标网段
      input#target.form-control(type='text' name='target' placeholder='例如 10.11.12.0/24' value=(undefined===route? '' : route.target))

    .form-group
      label(for='via') 网关
      input#via.form-control(type='text' name='via' placeholder='例如 172.16.2.1；如果目标就是当前 ZeroTier 网络可留空' value=(undefined===route? '' : route.via))

    .action-bar
      button.btn.btn-primary(type='submit') 保存
      a.btn.btn-default(href=('/controller/network/' + network.nwid) name='cancel' role='button') 取消

  if errors
    .alert.alert-warning
      ul
        for err in errors
          li!= err.msg
