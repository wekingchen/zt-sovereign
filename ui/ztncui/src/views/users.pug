extends users_layout

block users_content
  if users && Object.keys(users).length
    .table-responsive
      table.table.table-striped.table-hover
        thead
          tr
            th
            th 管理员
            th 操作
        tbody
          each user in users
            tr
              td
                a.btn.btn-link.btn-sm(href='/users/' + user.name + '/delete' title='删除管理员')
                  i.glyphicon.glyphicon-trash
              td
                a.network-name(href='/users/' + user.name + '/password') #{user.name}
              td
                a.btn.btn-default.btn-sm(href='/users/' + user.name + '/password') 设置密码
  else
    .empty-state
      span.glyphicon.glyphicon-user.empty-state-icon
      h4 暂无管理员
      p 创建管理员账号后即可在这里管理密码与访问权限。
      a.btn.btn-primary(href='/users/create')
        span.glyphicon.glyphicon-plus.nav-icon
        | 新建管理员
