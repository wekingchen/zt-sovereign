extends network_layout

block net_content
  .empty-state
    span.glyphicon.glyphicon-wrench.empty-state-icon
    h4 暂未提供此项编辑
    p
      | 当前页面尚未实现对
      strong  #{title}
      |  的直接编辑。
    if member !== undefined
      p
        | 成员：
        a.mono-link(href='../' + member.address) #{member.address}
    p.muted 部分属性可以在网络成员列表中直接修改。
    a.btn.btn-default(href='/controller/network/' + network.nwid + '#members') 返回成员列表
