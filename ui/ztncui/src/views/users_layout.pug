extends head_layout

block nav_items
  +nav_item('controller_home', '首页', '/controller')
  +nav_item('networks', '网络', '/controller/networks')
  +nav_item('users', '管理员', '/users')

block body_content
  main.app-main
    .container.app-container
      .page-surface
        if error
          .alert.alert-danger
            strong #{error}
        else
          .page-heading
            div
              h1= title
              block users_heading_meta
            block users_heading_action
          block users_content
