extends network_layout

block net_content
  .section-heading
    div
      h3 成员详情
      p.muted
        = member.name || '未命名成员'
        |  · 
        span.mono-text= member.address

  .detail-grid
    each value, key in member
      .detail-row
        .detail-label
          a(href=('/controller/network/' + member.nwid + '/member/' + member.address + '/' + key)) #{zhLabel(key)}
        .detail-value
          +json_value(value)

  .action-bar(style='margin-top: 22px;')
    a.btn.btn-default(href=('/controller/network/' + member.nwid + "#members") name='networks' role='button')
      span.glyphicon.glyphicon-chevron-left.nav-icon
      | 返回成员列表
