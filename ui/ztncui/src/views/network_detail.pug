extends network_layout

block title

block network_title
  .network-heading
    h2
      | 网络 
      a#change-name(href='#')
        span#name= network.name
        i.glyphicon.glyphicon-pencil.edit-icon
    span.network-id #{network.nwid}
    input#name-input.form-control(type='text' style='width: 220px; display: none;')
  script.
    $(function() {
      var nwurl = '/controller/network/#{network.nwid}';
      var name = !{JSON.stringify(network.name)};

      function toggleNameEditor(show) {
        $('#change-name').css('display', !show ? '' : 'none');
        $('#name-input').css('display', show ? 'inline-block' : 'none');
      }

      function submit() {
        var newName = $('#name-input').val();
        if (newName != name) {
          name = newName;
          $.post(nwurl + '/name', {'name': name})
            .done(function () {
              $('#name').text(newName);
            });
        }
        toggleNameEditor(false);
      }

      $('#change-name').on('click', function() {
        toggleNameEditor(true);
        $('#name-input').val(name);
        $('#name-input').focus();
      });
      $('#name-input').on('focusout', submit);
      $('#name-input').keypress(function (e) {
        if (e.which == 13) submit();
      });
    });

block net_content
  - const nwurl = '/controller/network/' + network.nwid;

  .network-actions
    a.btn.btn-primary(href=(nwurl + '/private') role='button')
      span.glyphicon.glyphicon-lock.nav-icon
      = network.private ? "私有网络" : "公开网络"
    a.btn.btn-default(href=(nwurl + '/easy') role='button') 快速设置
    a.btn.btn-default(href=(nwurl + '/routes') role='button') 受管路由
    a.btn.btn-default(href=(nwurl + '/ipAssignmentPools') role='button') IP 分配池
    a.btn.btn-default(href=(nwurl + '/v4AssignMode') role='button') IPv4 分配模式
    a.btn.btn-default(href=(nwurl + '/v6AssignMode') role='button') IPv6 分配模式
    a.btn.btn-default(href=(nwurl + '/dns') role='button') DNS

  if (members !== undefined)
    script.
      $(function() {
        const url = "#{nwurl}/members";
        $('.authCheck').on('click', function() {
          $.post(url, {'id': this.value, 'auth': this.checked});
        });
        $('.bridgeCheck').on('click', function() {
          $.post(url, {'id': this.value, 'activeBridge': this.checked});
        });
        $('.text').on('change', function() {
          $.post(url, {'id': this.name, 'name': this.value});
        });
      });

    .section-heading
      div
        h3#members 成员
        p.muted 当前网络共 #{members.length} 个成员
      a.btn.btn-default.btn-sm(href='' name='refresh' role='button')
        span.glyphicon.glyphicon-refresh.nav-icon
        | 刷新

    if members.length > 0
      .table-responsive
        table.table.table-striped.table-hover.member-table
          thead
            tr
              th
              th 成员名称
              th 成员 ID
              th 已授权
              th 活动桥接
              th IP 分配
              th 节点状态
              th 节点地址 / 延迟
          tbody
            each member in members
              - const peer = member.peer;
              - const url = nwurl + '/member/' + member.id
              tr
                td
                  a.btn.btn-link.btn-sm(href=url + '/delete' title='删除成员')
                    i.glyphicon.glyphicon-trash
                td
                  input.form-control.text(type='text' name=member.id value=member.name)
                td
                  a.mono-link(href=url) #{member.id}
                td
                  input.authCheck(type='checkbox' value=member.id checked=(member.authorized? true : false))
                td
                  input.bridgeCheck(type='checkbox' value=member.id checked=(member.activeBridge? true : false))
                td
                  each ipAssignment in member.ipAssignments
                    a.mono-link(href=nwurl + '/member/' + member.id + '/ipAssignments')
                      = ipAssignment
                      = ' '
                  else
                    a(href=nwurl + '/member/' + member.id + '/ipAssignments') 设置 IP
                td
                  if (peer && peer.latency != -1 && peer.versionMajor != -1)
                    if (peer.latency != -1)
                      span.status-pill.status-online 在线 · v#{peer.version}
                    else
                      span.status-pill.status-relay 中继 · v#{peer.version}
                  else if (member.id == zt_address)
                    span.status-pill.status-controller 控制器
                  else
                    span.status-pill.status-offline 离线
                td
                  if (peer)
                    each path in peer.paths
                      if (path.preferred == true)
                        - const [ip, port] = path.address.split('/');
                        span.mono-text= ip
                        span.muted /#{port}
                        if (peer.latency != -1)
                          br
                          span.muted #{peer.latency} 毫秒
                        - break
    else
      .empty-state
        span.glyphicon.glyphicon-link.empty-state-icon
        h4 暂无成员
        p 当前网络还没有设备加入。
        code= network.nwid

  .section-heading
    div
      h3#detail 网络详细信息
      p.muted ZeroTier Controller 返回的当前网络配置

  .detail-grid
    each value, key in network
      .detail-row
        .detail-label
          a(href= network.nwid + '/' + key) #{zhLabel(key)}
        .detail-value
          +json_value(value)

  .action-bar(style='margin-top: 22px;')
    a.btn.btn-default(href='/controller/networks' name='networks' role='button')
      span.glyphicon.glyphicon-th-list.nav-icon
      | 返回网络列表
