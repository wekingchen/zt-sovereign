extends controller_layout

block content
  .page-heading
    div
      h1= title
      p.muted 管理此 Controller 上的 ZeroTier 网络
    a.btn.btn-primary(href='/controller/network/create')
      span.glyphicon.glyphicon-plus.nav-icon
      | 新建网络

  if error
    .alert.alert-danger
      strong #{error}
  else if networks && networks.length
    .table-responsive
      table.table.table-striped.table-hover
        thead
          tr
            th
            th 网络名称
            th 网络 ID
            th 快捷操作
        tbody
          each network in networks
            - const nwurl = '/controller/network/' + network.nwid;
            tr
              td
                a.btn.btn-link.btn-sm(href=nwurl + '/delete' title='删除网络')
                  i.glyphicon.glyphicon-trash
              td
                a.network-name(href=nwurl) #{network.name}
              td
                span.mono-text #{network.nwid}
              td
                .table-actions
                  a.btn.btn-default.btn-sm(href=nwurl) 详情
                  a.btn.btn-default.btn-sm(href=nwurl + '/easy') 快速设置
                  a.btn.btn-default.btn-sm(href=nwurl + "#members") 成员
  else
    .empty-state
      span.glyphicon.glyphicon-globe.empty-state-icon
      h4 还没有网络
      p 创建第一个 ZeroTier 网络后，就可以在这里管理成员、路由与地址分配。
      a.btn.btn-primary(href='/controller/network/create')
        span.glyphicon.glyphicon-plus.nav-icon
        | 新建网络
