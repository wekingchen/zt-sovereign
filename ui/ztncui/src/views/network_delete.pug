extends network_layout

block net_content
  if network.deleted
    .alert.alert-success
      strong #{network.name} (#{network.nwid}) 已删除
  else
    .danger-panel
      h4 删除网络
      p 删除后无法恢复此网络配置，请确认已备份需要保留的信息。
      p
        strong= network.name
        |  · 
        span.mono-text= network.nwid
      form(method='POST' action='')
        .action-bar
          button.btn.btn-danger(type='submit', name='delete')
            span.glyphicon.glyphicon-trash.nav-icon
            | 确认删除
          a.btn.btn-default(href='/controller/networks', name='cancel', role='button') 取消

  if errors
    .alert.alert-warning
      ul
        for err in errors
          li!= err.msg
